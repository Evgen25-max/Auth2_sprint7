# ==============================================================================
# 1. ОБЩИЕ НАСТРОЙКИ ПРОЕКТА
# ==============================================================================
PROJECT_NAME="Movie theater"                # Название проекта, может использоваться в заголовках ответов или Swagger UI
PROJECT_DESCRIPTION="The best movie theater for everyone" # Краткое описание проекта для документации (OpenAPI/Swagger)
DEBUG=False                                 # Режим отладки.
DATABASE_TYPE=postgres                      # Глобальный тип используемой СУБД
PROJECT_NAME_FASTAPI=movies                 # Внутреннее имя сервиса FastAPI

# ==============================================================================
# 2. СЕТЕВАЯ БЕЗОПАСНОСТЬ И ДОСТУП
# ==============================================================================
SECRET_KEY=ferrrrrrrrrrrrrrrr # Глобальный секретный ключ Django/FastAPI.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]     # Список разрешённых хостов для Django
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080 # Разрешённые источники для CORS (фронтенд)

# ==============================================================================
# 3. ОСНОВНАЯ БАЗА ДАННЫХ
# ==============================================================================
SQL_ENGINE=django.db.backends.postgresql_psycopg2 # Движок базы данных для Django (PostgreSQL через psycopg2)
POSTGRES_HOST=theatre-db                    # Имя сервиса (контейнера) с базой данных в Docker Compose
POSTGRES_PORT=5432                          # Стандартный порт PostgreSQL
POSTGRES_DB=theatre                         # Имя основной базы данных приложения
POSTGRES_USER=postgres                      # Пользователь БД
POSTGRES_PASSWORD=secr!!!et                    # Пароль пользователя БД (в проде должен быть сложным и храниться в секретах)
POSTGRES_OPTIONS=-c search_path=public,content # Параметры подключения: установка пути поиска схем (сначала public, потом content)

# ==============================================================================
# 4. БАЗА ДАННЫХ AUTH-СЕРВИСА (AUTH SERVICE DB)
# ==============================================================================
# Разделение на админа и app-пользователя — это принцип наименьших привилегий
POSTGRES_AUTH_HOST=theatre-db               # Хост БД
POSTGRES_AUTH_PORT=5432                     # Порт PostgreSQL
POSTGRES_AUTH_DB=auth_service_db            # Имя базы данных для сервиса авторизации
POSTGRES_AUTH_SCHEMA=auth                   # Схема внутри БД, где хранятся таблицы auth-сервиса
POSTGRES_AUTH_USER=auth_admin               # Пользователь с правами на создание/изменение схем и таблиц (для миграций Alembic/Django)
POSTGRES_AUTH_PASSWORD=se!cretzauthadamin   # Пароль администратора БД auth-сервиса
POSTGRES_AUTH_APP_USER=auth_app             # Пользователь приложения (только SELECT, INSERT, UPDATE, DELETE, без прав на DDL)
POSTGRES_AUTH_APP_PASSWORD=secretaadfeuthuser   # Пароль пользователя приложения auth-сервиса

# ==============================================================================
# 5. ПОИСКОВЫЙ ДВИЖОК (ELASTICSEARCH)
# ==============================================================================
ELASTIC_HOST=elasticsearch                  # Имя сервиса (контейнера) Elasticsearch в Docker Compose
ELASTIC_PORT=9200                           # Стандартный HTTP-порт Elasticsearch
ELASTIC_SCHEMA=http://                      # Протокол подключения (в проде рекомендуется https://)

# ==============================================================================
# 6. КЭШИРОВАНИЕ И СОСТОЯНИЕ (REDIS INSTANCES)
# ==============================================================================
# 6.1. Основной кэш (General Cache)
REDIS_HOST=redis                            # Имя сервиса основного Redis
REDIS_PORT=6379                             # Стандартный порт Redis
REDIS_PASSW=redissecret                     # Пароль для подключения к основному Redis
REDIS_CACHE_DB=0                            # Номер логической базы данных Redis для основного кэша (0-15)

# 6.2. Кэш Auth-сервиса
REDIS_AUTH_HOST=auth-redis                  # Имя сервиса выделенного Redis для auth
REDIS_AUTH_PORT=6380                        # Порт выделенного Redis (маппинг в docker-compose)
REDIS_AUTH_PASSW=your-auth-redis-password   # Пароль для Redis auth-сервиса
REDIS_AUTH_DB=1                             # Логическая БД Redis для auth-сервиса

# 6.3. Счётчики и статистика
STATS_REDIS_HOST=stats-redis                # Имя сервиса Redis для статистики
STATS_REDIS_PORT=6381                       # Порт сервиса статистики
STATS_REDIS_PASSW=statssecret               # Пароль сервиса статистики

# 6.4. Rate Limiting
RATELIMIT_REDIS_HOST=redis                  # Хост Redis для rate limiting
RATELIMIT_REDIS_PORT=6379                   # Порт Redis для rate limiting
RATELIMIT_REDIS_PASSW=redissecret           # Пароль Redis для rate limiting
RATELIMIT_REDIS_DB=2                        # Логическая БД Redis для rate limiting

# ==============================================================================
# 7. БЕЗОПАСНОСТЬ АВТОРИЗАЦИИ
# ==============================================================================
PASSWORD_PEPPER=super_secretr43crr4r34 # "Перец" — глобальный секрет, добавляемый к паролю до хеширования. Хранится только в env, не в БД
JWT_SECRET_KEY=dscs44ds-r-secret-jwt-key-dsds2-sdf-to-a-cs-string # Секретный ключ для подписи JWT-токенов. Должен быть сложным и уникальным
JWT_ALGORITHM=HS256                         # Алгоритм шифрования JWT (HMAC with SHA-256). Стандартный и надежный для симметричных ключей

# ==============================================================================
# 8. НАСТРОЙКИ БИЗНЕС-ЛОГИКИ И ИНТЕГРАЦИЙ
# ==============================================================================
AUTH_SERVICE_URL=http://auth-service:8001   # URL Auth-сервиса для внутренних запросов
PERMS_CACHE_TTL_SECONDS=900                 # Время жизни (TTL) кэша прав пользователя в секундах (900 сек = 15 минут)
RATE_LIMIT_REQUESTS=100                     # Максимальное количество запросов от одного клиента
RATE_LIMIT_PERIOD=60                        # Временное окно для rate limiting в секундах (100 запросов в минуту)

# ==============================================================================
# 9. НАБЛЮДАЕМОСТЬ И ТЕЛЕМЕТРИЯ
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317 # Endpoint для отправки трейсов в Jaeger по протоколу OTLP (порт 4317 — стандартный gRPC порт)

# ==============================================================================
# 10. СКРИПТЫ ИНИЦИАЛИЗАЦИИ И МИГРАЦИЙ (STARTUP & SCRIPTS)
# ==============================================================================
FAILED_TIMEOUT=7                            # Таймаут (в секундах) перед повторной попыткой подключения к БД при старте (wait-for-it логика)
SLEEP_TIME=5                                # Время ожидания (в секундах) между попытками подключения при сбоях
BATCH_SIZE=200                              # Размер пакета (chunk size) для пакетной вставки/обработки данных в скриптах миграции или синхронизации

# ==============================================================================
# 11. КЛЮЧИ (ПРЕФИКСЫ) В REDIS ДЛЯ AUTH-СЕРВИСА
# ==============================================================================
FAILED_ATTEMPTS_PREFIX=auth:failed          # Префикс ключа Redis для счётчика неудачных попыток входа (формат: auth:failed:{user_id}, TTL = окно блокировки)
LOCKOUT_PREFIX=auth:lockout                 # Префикс ключа Redis для факта блокировки аккаунта (формат: auth:lockout:{user_id}, значение '1', TTL = время блокировки)

YANDEX_CLIENT_ID=34r3f4f34f43f3f
YANDEX_CLIENT_SECRET=f43f4f34f34
YANDEX_REDIRECT_URI=http://127.0.0.1/auth/callback
YANDEX_AUTH_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_INFO_URL=https://login.yandex.ru/info


INTERNAL_API_KEY=545t454-service-to-service-communication